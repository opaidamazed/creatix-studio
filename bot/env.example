# توكن البوت من Discord Developer Portal ← Bot
DISCORD_BOT_TOKEN=put_your_token_here

# رابط الـ Worker (من غير / في الآخر)
API_URL=https://creatix-studio-bot.opaidamazed.workers.dev

# نفس قيمة BOT_API_SECRET اللي حطيتها في Cloudflare
BOT_API_SECRET=put_the_same_secret_here
# Discord presence (applied whenever the bot process connects)
# Allowed status values: online, idle, dnd, invisible
BOT_STATUS=online

# Allowed activity types: playing, watching, listening, competing, none
BOT_ACTIVITY_TYPE=watching
BOT_ACTIVITY_TEXT=your community
